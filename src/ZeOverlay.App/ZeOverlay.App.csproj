<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ZeOverlay.App</RootNamespace>
    <AssemblyName>ZeOverlay</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeOverlay.Core\ZeOverlay.Core.csproj" />
    <ProjectReference Include="..\ZeOverlay.Platform.Windows\ZeOverlay.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- OCR 模型与字典跟着 exe 走（PLAN 第 1.3 节：数据固定在 exe 旁） -->
    <None Include="..\..\models\**\*"
          Link="models\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      DirectML 运行库：ORT 1.24 的 DML EP 需要配套版本（不是 System32 里的 in-box 旧版，
      否则运行时报 0x80070057）。Microsoft.AI.DirectML 是传递依赖，其 build targets 不会被导入，
      所以这里显式引用并把 win-x64 的 DirectML.dll 复制到 exe 旁。
    -->
    <PackageReference Include="Microsoft.AI.DirectML" Version="1.15.4" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgMicrosoft_AI_DirectML)\bin\x64-win\DirectML.dll"
          Link="DirectML.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
