<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ZeOverlay.App</RootNamespace>
    <AssemblyName>ZeOverlay</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeOverlay.Core\ZeOverlay.Core.csproj" />
    <ProjectReference Include="..\ZeOverlay.Platform.Windows\ZeOverlay.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- OCR 模型与字典跟着 exe 走（PLAN 第 1.3 节：数据固定在 exe 旁） -->
    <None Include="..\..\models\**\*"
          Link="models\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
