<Window x:Class="ZeOverlay.App.RoiSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="框选列表区域"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        Cursor="Cross"
        UseLayoutRounding="False"
        SnapsToDevicePixels="False">

    <Canvas x:Name="Root">
        <!-- 全屏遮罩 + 挖空选区 -->
        <Path x:Name="Mask" Fill="#B4000000" IsHitTestVisible="False" />

        <!-- 选区边框 -->
        <Rectangle x:Name="SelectionOutline"
                   Stroke="#FF22D3EE"
                   StrokeThickness="2"
                   Fill="Transparent"
                   Visibility="Collapsed"
                   IsHitTestVisible="False" />

        <!-- 顶部操作提示 -->
        <Border x:Name="HintPanel"
                Background="#E6111111"
                BorderBrush="#FF3F3F46"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,8">
            <TextBlock x:Name="HintText"
                       Foreground="#FFF2F2F2"
                       FontSize="14"
                       Text="拖动框选「神器列表」的整个区域" />
        </Border>

        <!-- 尺寸角标 -->
        <Border x:Name="SizePanel"
                Background="#E6111111"
                BorderBrush="#FF22D3EE"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8,3"
                Visibility="Collapsed">
            <TextBlock x:Name="SizeText"
                       Foreground="#FF22D3EE"
                       FontFamily="Consolas"
                       FontSize="13"
                       Text="0 x 0" />
        </Border>
    </Canvas>
</Window>
