<Window x:Class="ZeOverlay.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeOverlay · 设置" Width="820" Height="560"
        WindowStartupLocation="CenterOwner" Background="#FF1B1B1F">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="关注名单" Foreground="#FFE4E4E7" FontSize="20" FontWeight="SemiBold" />
        <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <GroupBox Header="关注名单（最多 10 项；为空时显示全部）" Foreground="#FFE4E4E7">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox x:Name="NameTextBox" Width="150" Height="26" Margin="0,0,8,0" />
                        <Button Content="添加" Width="62" Click="OnAddClick" />
                        <Button Content="删除选中" Margin="8,0,0,0" Click="OnRemoveClick" />
                    </StackPanel>
                    <ListBox x:Name="NamesList" DisplayMemberPath="." />
                </DockPanel>
            </GroupBox>
            <GroupBox Grid.Column="2" Header="显示顺序（只移动顺序）" Foreground="#FFE4E4E7">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="上移" Width="62" Click="OnMoveUpClick" />
                        <Button Content="下移" Width="62" Margin="8,0,0,0" Click="OnMoveDownClick" />
                    </StackPanel>
                    <ListBox x:Name="OrderList" DisplayMemberPath="." />
                </DockPanel>
            </GroupBox>
            <GroupBox Grid.Column="4" Header="最近识别" Foreground="#FFE4E4E7">
                <DockPanel Margin="8">
                    <Button DockPanel.Dock="Bottom" Content="一键加入选中项" Margin="0,8,0,0" Click="OnAddRecentClick" />
                    <ListBox x:Name="RecentList" DisplayMemberPath="." />
                </DockPanel>
            </GroupBox>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="模糊匹配阈值（0.50–1.00）：" Foreground="#FFE4E4E7" VerticalAlignment="Center" />
            <TextBox x:Name="ThresholdTextBox" Width="70" Height="26" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Width="80" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="保存" Width="80" IsDefault="True" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
