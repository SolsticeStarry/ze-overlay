<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>ZeOverlay.Platform.Windows</RootNamespace>
    <AssemblyName>ZeOverlay.Platform.Windows</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeOverlay.Core\ZeOverlay.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- GDI 截屏与 PNG 编解码。仅 Windows 支持；后续 WGC / 桌面复制后端会替换它。 -->
    <!-- DirectML 包自带 CPU EP，可在运行时选 DML 或回退 CPU。
         注意：它与 Microsoft.ML.OnnxRuntime（纯 CPU）提供同名 native 文件，不能同时引用。 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

</Project>
