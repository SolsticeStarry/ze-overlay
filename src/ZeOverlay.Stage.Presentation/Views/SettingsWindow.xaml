<Window x:Class="ZeOverlay.Stage.Presentation.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeOverlay · 设置" Width="900" Height="680"
        Icon="pack://application:,,,/ZeOverlay.Stage.Presentation;component/app.ico"
        WindowStartupLocation="CenterOwner" Background="#FF1B1B1F">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="设置" Foreground="#FFE4E4E7" FontSize="20" FontWeight="SemiBold" />

        <TabControl Grid.Row="1" Margin="0,12,0,10" Background="#FF1B1B1F"
                    Foreground="#FFE4E4E7" BorderBrush="#FF3F3F46">

            <!-- ========== 关注名单 ========== -->
            <TabItem Header="关注名单">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="12"/>
                        <ColumnDefinition/><ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="关注名单（最多 10 项；为空时显示全部）" Foreground="#FFE4E4E7">
                        <DockPanel Margin="8">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBox x:Name="NameTextBox" Width="150" Height="26" Margin="0,0,8,0" />
                                <Button Content="添加" Width="62" Click="OnAddClick" />
                                <Button Content="删除选中" Margin="8,0,0,0" Click="OnRemoveClick" />
                            </StackPanel>
                            <ListBox x:Name="NamesList" DisplayMemberPath="." />
                        </DockPanel>
                    </GroupBox>
                    <GroupBox Grid.Column="2" Header="显示顺序（只移动顺序）" Foreground="#FFE4E4E7">
                        <DockPanel Margin="8">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="上移" Width="62" Click="OnMoveUpClick" />
                                <Button Content="下移" Width="62" Margin="8,0,0,0" Click="OnMoveDownClick" />
                            </StackPanel>
                            <ListBox x:Name="OrderList" DisplayMemberPath="." />
                        </DockPanel>
                    </GroupBox>
                    <GroupBox Grid.Column="4" Header="最近识别" Foreground="#FFE4E4E7">
                        <DockPanel Margin="8">
                            <Button DockPanel.Dock="Bottom" Content="一键加入选中项" Margin="0,8,0,0" Click="OnAddRecentClick" />
                            <ListBox x:Name="RecentList" DisplayMemberPath="." />
                        </DockPanel>
                    </GroupBox>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="模糊匹配阈值（0.50–1.00）：" Foreground="#FFE4E4E7" VerticalAlignment="Center" />
                        <TextBox x:Name="ThresholdTextBox" Width="70" Height="26" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ========== 显示与频率 ========== -->
            <TabItem Header="显示与频率">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="显示" Foreground="#FFA5F3FC" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="排序方式：" Foreground="#FFE4E4E7" Width="120" VerticalAlignment="Center" />
                            <ComboBox x:Name="SortModeBox" Width="220" Height="26">
                                <ComboBoxItem Content="名单 / 显示顺序" Tag="watchlist" />
                                <ComboBoxItem Content="页 - 行（列表原序）" Tag="slot" />
                                <ComboBoxItem Content="就绪优先 + 冷却升序" Tag="cooldown" />
                                <ComboBoxItem Content="名称" Tag="name" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="字号：" Foreground="#FFE4E4E7" Width="120" VerticalAlignment="Center" />
                            <TextBox x:Name="FontSizeBox" Width="70" Height="26" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="背景不透明度：" Foreground="#FFE4E4E7" Width="120" VerticalAlignment="Center" />
                            <TextBox x:Name="BackgroundOpacityBox" Width="70" Height="26" />
                            <TextBlock Text="（0.00–1.00）" Foreground="#FF71717A" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>

                        <CheckBox x:Name="ShowUsesCheck" Content="显示剩余次数 n/m" Foreground="#FFE4E4E7" Margin="0,0,0,6" />
                        <CheckBox x:Name="ShowPageSlotCheck" Content="显示 #页-行 前缀" Foreground="#FFE4E4E7" Margin="0,0,0,6" />
                        <CheckBox x:Name="ShowSourceMarkCheck" Content="外推条目标记 ~" Foreground="#FFE4E4E7" Margin="0,0,0,6" />

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <TextBlock Text="实时颜色：" Foreground="#FFE4E4E7" Width="120" VerticalAlignment="Center" />
                            <TextBox x:Name="LiveColorBox" Width="120" Height="26" />
                            <TextBlock Text="外推颜色：" Foreground="#FFE4E4E7" Width="80" VerticalAlignment="Center" Margin="16,0,0,0" />
                            <TextBox x:Name="ExtrapolatedColorBox" Width="120" Height="26" />
                        </StackPanel>

                        <Separator Margin="0,10,0,10" Background="#FF3F3F46" />
                        <TextBlock Text="频率" Foreground="#FFA5F3FC" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="采集频率：" Foreground="#FFE4E4E7" Width="120" VerticalAlignment="Center" />
                            <TextBox x:Name="CaptureFpsBox" Width="70" Height="26" />
                            <TextBlock Text="Hz（1–10）" Foreground="#FF71717A" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="识别间隔：" Foreground="#FFE4E4E7" Width="120" VerticalAlignment="Center" />
                            <TextBox x:Name="RecognitionIntervalBox" Width="70" Height="26" />
                            <TextBlock Text="ms（200–5000；越小越跟手，越吃 CPU）" Foreground="#FF71717A" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== 热键 ========== -->
            <TabItem Header="热键">
                <StackPanel Margin="12">
                    <TextBlock Text="点击右侧输入框后直接按下组合键即可录入（如 Ctrl+Shift+O）；留空则用内置候选。"
                               Foreground="#FF71717A" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="显示/隐藏预览：" Foreground="#FFE4E4E7" Width="140" VerticalAlignment="Center" />
                        <TextBox x:Name="HotkeyTogglePreview" Width="200" Height="26" IsReadOnly="True"
                                 PreviewKeyDown="OnHotkeyCapture" />
                        <Button Content="清除" Margin="8,0,0,0" Tag="HotkeyTogglePreview" Click="OnHotkeyClear" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="重新框选 ROI：" Foreground="#FFE4E4E7" Width="140" VerticalAlignment="Center" />
                        <TextBox x:Name="HotkeySelectRoi" Width="200" Height="26" IsReadOnly="True"
                                 PreviewKeyDown="OnHotkeyCapture" />
                        <Button Content="清除" Margin="8,0,0,0" Tag="HotkeySelectRoi" Click="OnHotkeyClear" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="保存截图：" Foreground="#FFE4E4E7" Width="140" VerticalAlignment="Center" />
                        <TextBox x:Name="HotkeySnapshot" Width="200" Height="26" IsReadOnly="True"
                                 PreviewKeyDown="OnHotkeyCapture" />
                        <Button Content="清除" Margin="8,0,0,0" Tag="HotkeySnapshot" Click="OnHotkeyClear" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="显示/隐藏叠加：" Foreground="#FFE4E4E7" Width="140" VerticalAlignment="Center" />
                        <TextBox x:Name="HotkeyToggleOverlay" Width="200" Height="26" IsReadOnly="True"
                                 PreviewKeyDown="OnHotkeyCapture" />
                        <Button Content="清除" Margin="8,0,0,0" Tag="HotkeyToggleOverlay" Click="OnHotkeyClear" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="拖动叠加：" Foreground="#FFE4E4E7" Width="140" VerticalAlignment="Center" />
                        <TextBox x:Name="HotkeyDragOverlay" Width="200" Height="26" IsReadOnly="True"
                                 PreviewKeyDown="OnHotkeyCapture" />
                        <Button Content="清除" Margin="8,0,0,0" Tag="HotkeyDragOverlay" Click="OnHotkeyClear" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="退出：" Foreground="#FFE4E4E7" Width="140" VerticalAlignment="Center" />
                        <TextBox x:Name="HotkeyQuit" Width="200" Height="26" IsReadOnly="True"
                                 PreviewKeyDown="OnHotkeyCapture" />
                        <Button Content="清除" Margin="8,0,0,0" Tag="HotkeyQuit" Click="OnHotkeyClear" />
                    </StackPanel>

                    <TextBlock Text="提示：被其它程序占用的组合会自动回退到候选，以状态栏显示的「实际生效」为准。"
                               Foreground="#FFFACC15" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Width="80" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="保存" Width="80" IsDefault="True" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
