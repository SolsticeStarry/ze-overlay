<Window x:Class="ZeOverlay.Stage.Presentation.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeOverlay · M0 列表区域预览"
        Icon="pack://application:,,,/ZeOverlay.Stage.Presentation;component/app.ico"
        Height="820"
        Width="980"
        Background="#FF1B1B1F"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FF232329"
                BorderBrush="#FF3F3F46"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,8">
            <TextBlock x:Name="StatusText"
                       Foreground="#FFE4E4E7"
                       FontFamily="Consolas"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="初始化中…" />
        </Border>

        <Border Grid.Row="1"
                Margin="0,8,0,8"
                Background="#FF000000"
                BorderBrush="#FF3F3F46"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <TextBlock x:Name="EmptyHint"
                           Foreground="#FF71717A"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Text="尚未标定列表区域&#x0a;用「重新框选」在画面上框选「神器列表」的整个区域" />
                <Image x:Name="PreviewImage"
                       Margin="4"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="#FF18181B"
                BorderBrush="#FF22D3EE"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,8"
                MaxHeight="240">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="RecognitionText"
                           Foreground="#FFA5F3FC"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Text="识别结果：（尚未识别）" />
            </ScrollViewer>
        </Border>

        <WrapPanel Grid.Row="3">
            <Button x:Name="SelectRoiButton" Content="重新框选" Click="OnSelectRoiClick" />
            <Button x:Name="SnapshotButton" Content="保存截图" Click="OnSnapshotClick" />
            <Button x:Name="PauseButton" Content="暂停采集" Click="OnPauseClick" />
            <Button x:Name="SettingsButton" Content="设置" Click="OnSettingsClick" />
            <Button x:Name="OpenShotsButton" Content="打开截图目录" Click="OnOpenShotsClick" />
            <Button x:Name="OpenLogsButton" Content="打开日志目录" Click="OnOpenLogsClick" />
            <Button x:Name="QuitButton" Content="退出" Click="OnQuitClick" />
        </WrapPanel>
    </Grid>
</Window>
