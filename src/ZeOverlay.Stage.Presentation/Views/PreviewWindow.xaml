<Window x:Class="ZeOverlay.Stage.Presentation.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ZeOverlay.Stage.Presentation"
        Title="ZeOverlay · 预览 + 设置"
        Icon="pack://application:,,,/ZeOverlay.Stage.Presentation;component/app.ico"
        Height="800"
        Width="1420"
        MinHeight="600"
        MinWidth="900"
        Background="#FF1B1B1F"
        WindowStartupLocation="Manual">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SettingsColumn" Width="620"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 顶部工具栏（整宽） -->
        <Border Grid.Row="0" Grid.ColumnSpan="3"
                Background="#FF232329" BorderBrush="#FF3F3F46" BorderThickness="1"
                CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
            <WrapPanel>
                <Button x:Name="SettingsToggleButton" Content="◀ 隐藏设置" Click="OnToggleSettingsClick" Margin="0,0,12,0" />
                <Button x:Name="SelectRoiButton" Content="重新框选" Click="OnSelectRoiClick" />
                <Button x:Name="SnapshotButton" Content="保存截图" Click="OnSnapshotClick" />
                <Button x:Name="PauseButton" Content="暂停采集" Click="OnPauseClick" />
                <Button x:Name="OpenShotsButton" Content="打开截图目录" Click="OnOpenShotsClick" />
                <Button x:Name="OpenLogsButton" Content="打开日志目录" Click="OnOpenLogsClick" />
                <Button x:Name="QuitButton" Content="退出" Click="OnQuitClick" />
            </WrapPanel>
        </Border>

        <!-- 左：设置面板 -->
        <views:SettingsPanel x:Name="SettingsPanelControl" Grid.Row="1" Grid.Column="0"/>

        <!-- 可拖动分隔条 -->
        <GridSplitter x:Name="SettingsSplitter" Grid.Row="1" Grid.Column="1"
                      Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="#FF3F3F46" ResizeBehavior="PreviousAndNext" />

        <!-- 右：预览 -->
        <Grid Grid.Row="1" Grid.Column="2" Margin="6,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FF000000"
                    BorderBrush="#FF3F3F46"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <TextBlock x:Name="EmptyHint"
                               Foreground="#FF71717A"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Text="尚未标定列表区域&#x0a;用「重新框选」在画面上框选「神器列表」的整个区域" />
                    <Image x:Name="PreviewImage"
                           Margin="4"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,8,0,0"
                    Background="#FF18181B"
                    BorderBrush="#FF22D3EE"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8"
                    MaxHeight="220">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="RecognitionText"
                               Foreground="#FFA5F3FC"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="识别结果：（尚未识别）" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部状态栏（整宽） -->
        <Border Grid.Row="2" Grid.ColumnSpan="3"
                Background="#FF18181B" BorderBrush="#FF3F3F46" BorderThickness="1"
                CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText"
                       Foreground="#FFE4E4E7"
                       FontFamily="Consolas"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="初始化中…" />
        </Border>
    </Grid>
</Window>
