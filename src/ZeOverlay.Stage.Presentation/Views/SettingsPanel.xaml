<UserControl x:Class="ZeOverlay.Stage.Presentation.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF1B1B1F">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="设置" Foreground="#FFE4E4E7" FontSize="18" FontWeight="SemiBold" />

        <TabControl Grid.Row="1" Margin="0,10,0,8" Background="#FF1B1B1F"
                    Foreground="#FFE4E4E7" BorderBrush="#FF3F3F46">

            <!-- ========== 关注名单 ========== -->
            <TabItem Header="关注名单">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="关注名单（最多 10 项；为空时显示全部）" Foreground="#FFE4E4E7" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBox x:Name="NameTextBox" Width="130" Height="26" Margin="0,0,8,0" />
                            <Button Content="添加" Width="56" Click="OnAddClick" />
                            <Button Content="删除选中" Margin="8,0,0,0" Click="OnRemoveClick" />
                        </StackPanel>
                        <ListBox x:Name="NamesList" DisplayMemberPath="." Height="120" />

                        <TextBlock Text="显示顺序（只移动顺序）" Foreground="#FFE4E4E7" Margin="0,12,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="上移" Width="56" Click="OnMoveUpClick" />
                            <Button Content="下移" Width="56" Margin="8,0,0,0" Click="OnMoveDownClick" />
                        </StackPanel>
                        <ListBox x:Name="OrderList" DisplayMemberPath="." Height="120" />

                        <TextBlock Text="最近识别（一键加入）" Foreground="#FFE4E4E7" Margin="0,12,0,6" />
                        <Button Content="加入选中项" HorizontalAlignment="Left" Click="OnAddRecentClick" />
                        <ListBox x:Name="RecentList" DisplayMemberPath="." Height="120" Margin="0,6,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="模糊匹配阈值（0.50–1.00）：" Foreground="#FFE4E4E7" VerticalAlignment="Center" />
                            <TextBox x:Name="ThresholdTextBox" Width="70" Height="26" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== 显示与频率 ========== -->
            <TabItem Header="显示与频率">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="显示" Foreground="#FFA5F3FC" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="排序方式：" Foreground="#FFE4E4E7" Width="110" VerticalAlignment="Center" />
                            <ComboBox x:Name="SortModeBox" Width="220" Height="26">
                                <ComboBoxItem Content="名单 / 显示顺序" Tag="watchlist" />
                                <ComboBoxItem Content="页 - 行（列表原序）" Tag="slot" />
                                <ComboBoxItem Content="就绪优先 + 冷却升序" Tag="cooldown" />
                                <ComboBoxItem Content="名称" Tag="name" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="字号：" Foreground="#FFE4E4E7" Width="110" VerticalAlignment="Center" />
                            <TextBox x:Name="FontSizeBox" Width="70" Height="26" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="背景不透明度：" Foreground="#FFE4E4E7" Width="110" VerticalAlignment="Center" />
                            <TextBox x:Name="BackgroundOpacityBox" Width="70" Height="26" />
                            <TextBlock Text="（0.00–1.00）" Foreground="#FF71717A" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>

                        <CheckBox x:Name="ShowUsesCheck" Content="显示剩余次数 n/m" Foreground="#FFE4E4E7" Margin="0,0,0,6" />
                        <CheckBox x:Name="ShowPageSlotCheck" Content="显示 #页-行 前缀" Foreground="#FFE4E4E7" Margin="0,0,0,6" />
                        <CheckBox x:Name="ShowPlayerNameCheck" Content="显示玩家名（最左固定列）" Foreground="#FFE4E4E7" Margin="0,0,0,6" />
                        <CheckBox x:Name="ShowSourceMarkCheck" Content="未扫描到标记 ~（置于最左）" Foreground="#FFE4E4E7" Margin="0,0,0,6" />
                        <CheckBox x:Name="ShowRowNumberCheck" Content="无数字标号时按类编号" Foreground="#FFE4E4E7" Margin="0,0,0,6" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="行间距：" Foreground="#FFE4E4E7" Width="110" VerticalAlignment="Center" />
                            <TextBox x:Name="RowSpacingBox" Width="70" Height="26" />
                            <TextBlock Text="px（-20–40）" Foreground="#FF71717A" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="玩家名列宽：" Foreground="#FFE4E4E7" Width="110" VerticalAlignment="Center" />
                            <TextBox x:Name="PlayerNameWidthBox" Width="70" Height="26" />
                            <TextBlock Text="px（40–400）" Foreground="#FF71717A" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <TextBlock Text="文字颜色：" Foreground="#FFE4E4E7" Width="110" VerticalAlignment="Center" />
                            <TextBox x:Name="LiveColorBox" Width="110" Height="26" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="未扫到 ~ 颜色：" Foreground="#FFE4E4E7" Width="110" VerticalAlignment="Center" />
                            <TextBox x:Name="ExtrapolatedColorBox" Width="110" Height="26" />
                        </StackPanel>

                        <Separator Margin="0,10,0,10" Background="#FF3F3F46" />
                        <TextBlock Text="频率" Foreground="#FFA5F3FC" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="采集频率：" Foreground="#FFE4E4E7" Width="110" VerticalAlignment="Center" />
                            <TextBox x:Name="CaptureFpsBox" Width="70" Height="26" />
                            <TextBlock Text="Hz（1–10）" Foreground="#FF71717A" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="识别间隔：" Foreground="#FFE4E4E7" Width="110" VerticalAlignment="Center" />
                            <TextBox x:Name="RecognitionIntervalBox" Width="70" Height="26" />
                            <TextBlock Text="ms（200–5000）" Foreground="#FF71717A" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="行消失超时：" Foreground="#FFE4E4E7" Width="110" VerticalAlignment="Center" />
                            <TextBox x:Name="RowDisappearBox" Width="70" Height="26" />
                            <TextBlock Text="秒（0.5–60）" Foreground="#FF71717A" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== 热键 ========== -->
            <TabItem Header="热键">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="点击右侧输入框后直接按下组合键即可录入；留空则用内置候选。"
                                   Foreground="#FF71717A" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="显示/隐藏预览：" Foreground="#FFE4E4E7" Width="130" VerticalAlignment="Center" />
                            <TextBox x:Name="HotkeyTogglePreview" Width="180" Height="26" IsReadOnly="True"
                                     PreviewKeyDown="OnHotkeyCapture" />
                            <Button Content="清除" Margin="8,0,0,0" Tag="HotkeyTogglePreview" Click="OnHotkeyClear" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="重新框选 ROI：" Foreground="#FFE4E4E7" Width="130" VerticalAlignment="Center" />
                            <TextBox x:Name="HotkeySelectRoi" Width="180" Height="26" IsReadOnly="True"
                                     PreviewKeyDown="OnHotkeyCapture" />
                            <Button Content="清除" Margin="8,0,0,0" Tag="HotkeySelectRoi" Click="OnHotkeyClear" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="保存截图：" Foreground="#FFE4E4E7" Width="130" VerticalAlignment="Center" />
                            <TextBox x:Name="HotkeySnapshot" Width="180" Height="26" IsReadOnly="True"
                                     PreviewKeyDown="OnHotkeyCapture" />
                            <Button Content="清除" Margin="8,0,0,0" Tag="HotkeySnapshot" Click="OnHotkeyClear" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="显示/隐藏叠加：" Foreground="#FFE4E4E7" Width="130" VerticalAlignment="Center" />
                            <TextBox x:Name="HotkeyToggleOverlay" Width="180" Height="26" IsReadOnly="True"
                                     PreviewKeyDown="OnHotkeyCapture" />
                            <Button Content="清除" Margin="8,0,0,0" Tag="HotkeyToggleOverlay" Click="OnHotkeyClear" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="拖动叠加：" Foreground="#FFE4E4E7" Width="130" VerticalAlignment="Center" />
                            <TextBox x:Name="HotkeyDragOverlay" Width="180" Height="26" IsReadOnly="True"
                                     PreviewKeyDown="OnHotkeyCapture" />
                            <Button Content="清除" Margin="8,0,0,0" Tag="HotkeyDragOverlay" Click="OnHotkeyClear" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="退出：" Foreground="#FFE4E4E7" Width="130" VerticalAlignment="Center" />
                            <TextBox x:Name="HotkeyQuit" Width="180" Height="26" IsReadOnly="True"
                                     PreviewKeyDown="OnHotkeyCapture" />
                            <Button Content="清除" Margin="8,0,0,0" Tag="HotkeyQuit" Click="OnHotkeyClear" />
                        </StackPanel>

                        <TextBlock Text="提示：被占用的组合会自动回退到候选，以状态栏「实际生效」为准。"
                                   Foreground="#FFFACC15" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <TextBlock x:Name="ApplyStatus" Foreground="#FF4ADE80" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button Content="应用设置" Width="100" Click="OnApplyClick" />
        </StackPanel>
    </Grid>
</UserControl>
